# Cloudflare Workers AI — used only for offline KG extraction/community reports
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_INDEX_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Local Ollama — used at query time (chat on GPU, embeddings on CPU)
OLLAMA_QUERY_URL=http://host.docker.internal:11434
OLLAMA_EMBED_URL=http://host.docker.internal:11435
OLLAMA_QUERY_MODEL=qwen2.5-rag
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Shared secret between the Express API and this sidecar. Must match Server/.env.
ASSISTANT_TOKEN=

# Sidecar runtime
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8000
ASSISTANT_ALLOW_REINDEX=false
ASSISTANT_ALLOW_GLOBAL=false
# true: seeded demo answers win; false: query GraphRAG first when the index is ready
ASSISTANT_CACHE_FIRST=true
