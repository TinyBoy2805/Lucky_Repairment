# ==== Server ====
PORT=3001
# Origin của client được phép gọi API (phân tách bằng dấu phẩy)
CLIENT_URL=http://localhost:5173

# ==== Phân quyền ====
# Email đăng ký Firebase sẽ được gán vai trò admin.
# BẮT BUỘC điền ít nhất 1 email, nếu không không ai có quyền admin.
ADMIN_EMAILS=

# ==== Firebase ====
FIREBASE_PROJECT_ID=lucky-repairment
FIREBASE_DATABASE_URL=https://lucky-repairment-default-rtdb.firebaseio.com
# Đường dẫn tới file service account (đã có sẵn trong thư mục Server/)
SERVICE_ACCOUNT_FILE=./serviceAccountKey.json
